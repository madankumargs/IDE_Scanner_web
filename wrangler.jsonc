{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abscissa-web-production",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat",
    "allow_importable_env",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "vars": {
    "GITHUB_OAUTH_CLIENT_ID": "Ov23liWQ5kElxVniE4tx",
    "GOOGLE_OAUTH_CLIENT_ID": "539877495650-9nrcag73os1umpgdi03lc2j4f9qien4s.apps.googleusercontent.com",
    "AUTH_EMAIL_FROM": "noreply@abscissa.dev"
  },
  "routes": [
    {
      "pattern": "abscissa.dev/*",
      "zone_name": "abscissa.dev"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "ABSCISSA_REGISTRY",
      "database_name": "abscissa-registry",
      "database_id": "00dc29ae-0815-4393-a915-d0cc07b36556",
      "migrations_dir": "d1/migrations"
    }
  ],
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["noreply@abscissa.dev"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "abscissa-web-production"
    },
    {
      "binding": "DEFAULT_WORKER",
      "service": "ide-scanner-web-server",
      "environment": "production"
    }
  ]
}
